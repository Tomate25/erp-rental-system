# --- CONFIGURACIÓN GENERAL DEL SISTEMA ---
PORT=3000
NODE_ENV=development # development, test, production
TRUSTED_PROXIES="loopback"

# --- CONFIGURACIÓN DE BASE DE DATOS (POSTGRESQL) ---
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://db_user:db_password@localhost:5432/erp_dev?schema=public"

# --- CONFIGURACIÓN DE CACHÉ (REDIS) ---
REDIS_URL="redis://localhost:6379"

# --- SEGURIDAD Y JWT ---
# Cambiar por frases secretas criptográficas largas y seguras en producción
JWT_ACCESS_SECRET="generate-a-strong-random-64-character-secret-for-access-token"
JWT_REFRESH_SECRET="generate-a-strong-random-64-character-secret-for-refresh-token"
JWT_ACCESS_EXPIRATION="8h"
JWT_REFRESH_EXPIRATION="7d"

# --- PROVEEDOR DE CORREO (SMTP) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-account@gmail.com"
SMTP_APP_PASSWORD="your-google-app-password"
SMTP_FROM="BM Construcciones <your-account@gmail.com>"
FRONTEND_PUBLIC_URL="http://localhost:5173"

# --- PROVEEDOR DE WHATSAPP BUSINESS ---
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# --- ALMACENAMIENTO DE ARCHIVOS (AWS S3 / MINIO / LOCAL) ---
STORAGE_PROVIDER="local" # local, s3, minio
STORAGE_BUCKET_NAME="erp-rental-assets"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ENDPOINT=""

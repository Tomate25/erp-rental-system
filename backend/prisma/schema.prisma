datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// --- MULTI-TENANCY ---

model Empresa {
  id        String   @id @default(uuid())
  nombre    String
  rfc       String // Identificación fiscal; el legado contiene duplicados que deben preservarse
  email     String
  telefono  String?
  direccion String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sucursales          Sucursal[]
  usuarios            Usuario[]
  clientes            Cliente[]
  equipos             Equipo[]
  productos           Producto[]
  cotizaciones        Cotizacion[]
  facturas            Factura[]
  solicitudesDespacho SolicitudDespacho[]
  solicitudesRetorno  SolicitudRetorno[]
  reglasComision      ReglaComision[]
  roles               Rol[]
  auditorias          Auditoria[]
  notificaciones      Notificacion[]
  vendedores          Vendedor[]
  planesComision      PlanComision[]
  periodosComision    PeriodoComision[]
  liquidacionesComision LiquidacionComision[]
  empleados           Empleado[]
  paramInss           ParamInss[]
  paramInatec         ParamInatec[]
  paramIrTramos       ParamIrTramo[]
  paramLaborales      ParamLaboral[]
  reglasIndemnizacion ReglaIndemnizacion[]
  conceptosNomina     ConceptoNomina[]
  periodosNomina      PeriodoNomina[]
  planillas           Planilla[]
  novedadesNomina     NovedadNomina[]
  prestamosEmpleados  PrestamoEmpleado[]

  @@index([rfc])
  @@map("empresas")
}

model Sucursal {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre    String
  codigo    String // Ej. SUC-NTE, SUC-SUR
  direccion String
  telefono  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuarios            Usuario[]
  equipos             Equipo[]
  contratos           Contrato[]
  despachos           Despacho[]
  devoluciones        Devolucion[]
  cotizaciones        Cotizacion[]
  facturas            Factura[]
  solicitudesDespacho SolicitudDespacho[]
  solicitudesRetorno  SolicitudRetorno[]
  vendedores          Vendedor[]
  empleados           Empleado[]
  planillas           Planilla[]

  @@unique([empresaId, codigo])
  @@map("sucursales")
}

// --- USUARIOS Y RBAC ---

model Usuario {
  id                     String    @id @default(uuid())
  empresaId              String    @map("empresa_id")
  empresa                Empresa   @relation(fields: [empresaId], references: [id])
  sucursalId             String?   @map("sucursal_id")
  sucursal               Sucursal? @relation(fields: [sucursalId], references: [id])
  email                  String    @unique
  password               String // Hash Argon2
  nombre                 String
  apellido               String
  activo                 Boolean   @default(true)
  intentosFallidos       Int       @default(0) @map("intentos_fallidos")
  bloqueado              Boolean   @default(false)
  bloqueadoHasta         DateTime? @map("bloqueado_hasta")
  requiereCambioPassword Boolean   @default(false) @map("requiere_cambio_password")
  sessionToken           String?   @map("session_token")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  roles             UsuarioRol[]
  auditorias        Auditoria[]
  cotizaciones      Cotizacion[]
  clientesAsignados Cliente[]       @relation("ClienteVendedor")
  reglasComision    ReglaComision[]
  vendedores        Vendedor[]

  @@map("usuarios")
}

model Rol {
  id          String   @id @default(uuid())
  empresaId   String?  @map("empresa_id")
  empresa     Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre      String // Ej. ADMIN, GERENTE, COMERCIAL, CLIENTE
  descripcion String?

  permisos RolPermiso[]
  usuarios UsuarioRol[]

  @@unique([empresaId, nombre])
  @@map("roles")
}

model Permiso {
  id          String  @id @default(uuid())
  codigo      String  @unique // Ej. CLIENT.CREATE, QUOTE.APPROVE
  descripcion String?

  roles RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     String  @map("rol_id")
  permisoId String  @map("permiso_id")
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permisos")
}

model UsuarioRol {
  usuarioId String  @map("usuario_id")
  rolId     String  @map("rol_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuario_roles")
}

// --- CLIENTES ---

model Cliente {
  id                 String   @id @default(uuid())
  empresaId          String   @map("empresa_id")
  empresa            Empresa  @relation(fields: [empresaId], references: [id])
  numeroCliente      String?  @map("numero_cliente")
  nombre             String // Nombre comercial o completo
  razonSocial        String?  @map("razon_social")
  rfc                String? // Identificación fiscal del cliente (Ruc)
  cedula             String?
  direccion          String?
  emailFacturacion   String?  @map("email_facturacion")
  telefono           String?
  telMovistar        String?  @map("tel_movistar")
  telClaro           String?  @map("tel_claro")
  telConvencional    String?  @map("tel_convencional")
  vendedor           String?
  vendedorId         String?  @map("vendedor_id")
  vendedorAsignado   Usuario? @relation("ClienteVendedor", fields: [vendedorId], references: [id])
  limiteCredito      Decimal? @map("limite_credito") @db.Decimal(12, 2)
  condicionPago      String?  @map("condicion_pago")
  tipoCliente        String?  @map("tipo_cliente")
  nombreContacto     String?  @map("nombre_contacto")
  nombreOriginal     String?  @map("nombre_original")
  departamento       String?  @map("departamento")
  observaciones      String?  @map("observaciones")
  whatsappHabilitado Boolean  @default(false) @map("whatsapp_habilitado")
  whatsappNumero     String?  @map("whatsapp_numero")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  contactos      ContactoCliente[]
  solicitudes    Solicitud[]
  cotizaciones   Cotizacion[]
  contratos      Contrato[]
  facturas       Factura[]
  notificaciones Notificacion[]

  @@map("clientes")
}

model ContactoCliente {
  id        String   @id @default(uuid())
  clienteId String   @map("cliente_id")
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nombre    String
  puesto    String?
  email     String   @unique
  telefono  String
  password  String? // Hash Argon2 si tiene acceso al portal de clientes
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contactos_cliente")
}

// --- INVENTARIO Y DISPONIBILIDAD ---

enum TipoControlEquipo {
  SERIALIZADO
  POR_CANTIDAD
}

enum TipoMedicionCombustible {
  BARRAS
  PORCENTAJE
  PULGADAS
}

enum ModalidadRenta {
  SOLO_DIA
  SOLO_HORA
  DIA_Y_HORA
}

enum NivelPrecio {
  PRECIO_A
  PRECIO_B
  PRECIO_C
}

enum EstadoEquipo {
  DISPONIBLE
  RESERVADO
  RENTADO
  RETORNO
  DESPACHADO
  EN_ALQUILER
  EN_RETORNO
  EN_INSPECCION
  EN_MANTENIMIENTO
  MANTENIMIENTO
  FUERA_DE_SERVICIO
  BAJA
}

model Categoria {
  id              String         @id @default(uuid())
  nombre          String
  descripcion     String?
  isLineaAmarilla Boolean        @default(false) @map("is_linea_amarilla")
  subcategorias   Subcategoria[]
  equipos         Equipo[]
  productos       Producto[]

  @@index([nombre])
  @@map("categorias")
}

model Subcategoria {
  id          String     @id @default(uuid())
  categoriaId String     @map("categoria_id")
  categoria   Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  equipos     Equipo[]
  productos   Producto[]

  @@unique([categoriaId, nombre])
  @@map("subcategorias")
}

model Marca {
  id        String     @id @default(uuid())
  nombre    String
  equipos   Equipo[]
  productos Producto[]

  @@index([nombre])
  @@map("marcas")
}

model Producto {
  id                      String                   @id @default(uuid())
  empresaId               String                   @map("empresa_id")
  empresa                 Empresa                  @relation(fields: [empresaId], references: [id])
  categoriaId             String                   @map("categoria_id")
  categoria               Categoria                @relation(fields: [categoriaId], references: [id])
  subcategoriaId          String?                  @map("subcategoria_id")
  subcategoria            Subcategoria?            @relation(fields: [subcategoriaId], references: [id])
  marcaId                 String                   @map("marca_id")
  marca                   Marca                    @relation(fields: [marcaId], references: [id])
  codigo                  String?                  @map("codigo")
  nombre                  String
  descripcion             String?
  tipoControl             TipoControlEquipo        @default(SERIALIZADO) @map("tipo_control")
  precioRentaDia          Decimal                  @map("precio_renta_dia") @db.Decimal(14, 4)
  precioRentaHora         Decimal?                 @map("precio_renta_hora") @db.Decimal(14, 4)
  precioDiaB              Decimal?                 @map("precio_dia_b") @db.Decimal(14, 4)
  precioDiaC              Decimal?                 @map("precio_dia_c") @db.Decimal(14, 4)
  precioHoraB             Decimal?                 @map("precio_hora_b") @db.Decimal(14, 4)
  precioHoraC             Decimal?                 @map("precio_hora_c") @db.Decimal(14, 4)
  minimoHoras             Int?                     @default(4) @map("minimo_horas")
  modalidadRenta          ModalidadRenta           @default(DIA_Y_HORA) @map("modalidad_renta")
  tipoMedicionCombustible TipoMedicionCombustible? @map("tipo_medicion_combustible")
  capacidadTanqueGalones  Float?                   @map("capacidad_tanque_galones")
  tieneHorometro          Boolean                  @default(false) @map("tiene_horometro")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  equipos            Equipo[]
  detallesCotizacion DetalleCotizacion[]

  @@map("productos")
}

model Equipo {
  id                      String                   @id @default(uuid())
  empresaId               String                   @map("empresa_id")
  empresa                 Empresa                  @relation(fields: [empresaId], references: [id])
  sucursalId              String                   @map("sucursal_id")
  sucursal                Sucursal                 @relation(fields: [sucursalId], references: [id])
  productoId              String?                  @map("producto_id")
  producto                Producto?                @relation(fields: [productoId], references: [id])
  categoriaId             String                   @map("categoria_id")
  categoria               Categoria                @relation(fields: [categoriaId], references: [id])
  subcategoriaId          String?                  @map("subcategoria_id")
  subcategoria            Subcategoria?            @relation(fields: [subcategoriaId], references: [id])
  marcaId                 String                   @map("marca_id")
  marca                   Marca                    @relation(fields: [marcaId], references: [id])
  codigo                  String?                  @map("codigo") // Código de artículo: 01-02, 02-64, etc.
  modelo                  String
  numeroSerie             String?                  @map("numero_serie") // Opcional para activos en masa
  tipoControl             TipoControlEquipo        @default(SERIALIZADO) @map("tipo_control")
  descripcion             String?
  estado                  EstadoEquipo             @default(DISPONIBLE)
  cantidadTotal           Int                      @default(1) @map("cantidad_total") // Stock total del artículo
  cantidadDisponible      Int                      @default(1) @map("cantidad_disponible") // Stock disponible (decrece al rentar)
  horometro               Float                    @default(0.0) // Horas de uso acumuladas
  horometroUltimoServicio Float                    @default(0.0) @map("horometro_ultimo_servicio") // Horas al último mantenimiento
  intervaloServicioHoras  Float                    @default(250.0) @map("intervalo_servicio_horas") // Intervalo (ej. 250 hrs)
  precioRentaDia          Decimal                  @map("precio_renta_dia") @db.Decimal(14, 4)
  precioRentaHora         Decimal?                 @map("precio_renta_hora") @db.Decimal(14, 4)
  precioDiaB              Decimal?                 @map("precio_dia_b") @db.Decimal(14, 4)
  precioDiaC              Decimal?                 @map("precio_dia_c") @db.Decimal(14, 4)
  precioHoraB             Decimal?                 @map("precio_hora_b") @db.Decimal(14, 4)
  precioHoraC             Decimal?                 @map("precio_hora_c") @db.Decimal(14, 4)
  minimoHoras             Int?                     @default(4) @map("minimo_horas")
  modalidadRenta          ModalidadRenta           @default(DIA_Y_HORA) @map("modalidad_renta")
  tipoMedicionCombustible TipoMedicionCombustible? @map("tipo_medicion_combustible")
  capacidadTanqueGalones  Float?                   @map("capacidad_tanque_galones")
  tieneHorometro          Boolean                  @default(false) @map("tiene_horometro")
  costoAdquisicion        Decimal?                 @map("costo_adquisicion") @db.Decimal(12, 2)
  fechaAdquisicion        DateTime?                @map("fecha_adquisicion")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  reservas           Reserva[]
  detallesContrato   DetalleContrato[]
  despachos          DetalleDespacho[]
  devoluciones       DetalleDevolucion[]
  mantenimientos     Mantenimiento[]
  detallesCotizacion DetalleCotizacion[]
  lecturasHorometro  LecturaHorometro[]

  @@index([empresaId, numeroSerie])
  @@map("equipos")
}

enum OrigenLecturaHorometro {
  DESPACHO
  RETORNO
  INSPECCION_CAMPO
  MANTENIMIENTO
  AJUSTE_MANUAL
}

model LecturaHorometro {
  id                String                 @id @default(uuid())
  equipoId          String                 @map("equipo_id")
  equipo            Equipo                 @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  horometroAnterior Float                  @map("horometro_anterior")
  horometroNuevo    Float                  @map("horometro_nuevo")
  horasTrabajadas   Float                  @map("horas_trabajadas")
  origen            OrigenLecturaHorometro @default(INSPECCION_CAMPO)
  registradoPor     String?                @map("registrado_por")
  observaciones     String?
  createdAt         DateTime               @default(now()) @map("created_at")

  @@map("lecturas_horometro")
}

// --- PROCESO COMERCIAL ---

enum EstadoSolicitud {
  PENDIENTE
  COTIZADA
  RECHAZADA
  CANCELADA
}

model Solicitud {
  id           String          @id @default(uuid())
  clienteId    String          @map("cliente_id")
  cliente      Cliente         @relation(fields: [clienteId], references: [id])
  fechaUso     DateTime        @map("fecha_uso")
  duracionDias Int             @map("duracion_dias")
  comentarios  String?
  estado       EstadoSolicitud @default(PENDIENTE)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@map("solicitudes")
}

enum EstadoCotizacion {
  BORRADOR
  PENDIENTE
  ENVIADA
  VISTA
  EN_REVISION
  ACEPTADA
  CONVERTIDA_A_CONTRATO
  FACTURADA
  RECHAZADA
  VENCIDA
  CANCELADA
}

model Cotizacion {
  id                   String           @id @default(uuid())
  empresaId            String?          @map("empresa_id")
  empresa              Empresa?         @relation(fields: [empresaId], references: [id])
  sucursalId           String?          @map("sucursal_id")
  sucursal             Sucursal?        @relation(fields: [sucursalId], references: [id])
  numeroCotizacion     String           @map("numero_cotizacion") // Ej. COT-0001
  version              Int              @default(1)
  clienteId            String           @map("cliente_id")
  cliente              Cliente          @relation(fields: [clienteId], references: [id])
  proyecto             String?
  atencion             String?
  telefono             String?
  email                String?
  referencia           String?
  asesorId             String?          @map("asesor_id")
  asesor               Usuario?         @relation(fields: [asesorId], references: [id])
  vendedorId           String?          @map("vendedor_id")
  vendedor             Vendedor?        @relation(fields: [vendedorId], references: [id])
  estado               EstadoCotizacion @default(BORRADOR)
  fechaEmision         DateTime         @default(now()) @map("fecha_emision")
  fechaVence           DateTime         @map("fecha_vence")
  validezDias          Int              @default(15) @map("validez_dias")
  fechaInicioRenta     DateTime?        @map("fecha_inicio_renta")
  fechaFinRenta        DateTime?        @map("fecha_fin_renta")
  subtotal             Decimal          @db.Decimal(12, 2)
  descuento            Decimal          @default(0.0) @db.Decimal(12, 2)
  iva                  Decimal          @db.Decimal(12, 2)
  total                Decimal          @db.Decimal(12, 2)
  depositoGarantia     Decimal          @default(0.0) @map("deposito_garantia") @db.Decimal(12, 2)
  condiciones          String?
  notasRevision        String?          @map("notas_revision")
  tokenPublico         String           @unique @default(uuid()) @map("token_publico")
  tokenPublicoRevocado Boolean          @default(false) @map("token_publico_revocado")
  motivoRechazo        String?          @map("motivo_rechazo")
  fechaEnvio           DateTime?        @map("fecha_envio")
  fechaVista           DateTime?        @map("fecha_vista")
  fechaAceptacion      DateTime?        @map("fecha_aceptacion")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  items     DetalleCotizacion[]
  contratos Contrato[]
  facturas  Factura[]

  @@map("cotizaciones")
}

/// Contadores atómicos de numeración (cotizaciones por empresa, contratos por año).
/// empresaId = 'GLOBAL' para contadores compartidos (Contrato.codigo es UNIQUE global).
/// Sin FK a propósito: 'GLOBAL' no es una empresa.
model SecuenciaNumeracion {
  id          String   @id @default(uuid())
  empresaId   String   @map("empresa_id")
  tipo        String
  ultimoValor Int      @default(0) @map("ultimo_valor")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([empresaId, tipo])
  @@map("secuencias_numeracion")
}

enum TipoCobro {
  POR_DIA
  POR_HORA
}

model DetalleCotizacion {
  id             String     @id @default(uuid())
  cotizacionId   String     @map("cotizacion_id")
  cotizacion     Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  productoId     String?    @map("producto_id")
  producto       Producto?  @relation(fields: [productoId], references: [id])
  equipoId       String?    @map("equipo_id")
  equipo         Equipo?    @relation(fields: [equipoId], references: [id])
  descripcion    String
  tipoCobro      TipoCobro  @default(POR_DIA) @map("tipo_cobro")
  cantidad       Int        @default(1)
  dias           Decimal?   @default(1) @db.Decimal(10, 2)
  horas          Decimal?   @db.Decimal(10, 2)
  precioUnitario Decimal     @map("precio_unitario") @db.Decimal(14, 4)
  nivelPrecio    NivelPrecio @default(PRECIO_A) @map("nivel_precio")
  descuento      Decimal     @default(0.0) @db.Decimal(12, 2)
  subtotal       Decimal    @db.Decimal(12, 2)

  @@map("detalle_cotizacion")
}

enum EstadoContrato {
  SIN_ABRIR
  ACTIVO
  FINALIZADO
  CANCELADO
  EN_DISPUTA
}

enum TipoCierreContrato {
  NORMAL
  ANTICIPADO
}

enum EstadoLiquidacionRetorno {
  PENDIENTE_APROBACION
  APROBADA
  ANULADA
}

enum DestinoCreditoRetorno {
  REEMBOLSO
  SALDO_FAVOR
}

model Contrato {
  id               String              @id @default(uuid())
  sucursalId       String              @map("sucursal_id")
  sucursal         Sucursal            @relation(fields: [sucursalId], references: [id])
  clienteId        String              @map("cliente_id")
  cliente          Cliente             @relation(fields: [clienteId], references: [id])
  cotizacionId     String?             @map("cotizacion_id")
  cotizacion       Cotizacion?         @relation(fields: [cotizacionId], references: [id])
  codigo           String              @unique
  fechaInicio      DateTime            @map("fecha_inicio")
  fechaFin         DateTime            @map("fecha_fin")
  fechaFinPactada  DateTime?           @map("fecha_fin_pactada")
  estado           EstadoContrato      @default(SIN_ABRIR)
  depositoGarantia Decimal             @default(0.0) @map("deposito_garantia") @db.Decimal(12, 2)
  condiciones      String
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  fechaCierreReal  DateTime?           @map("fecha_cierre_real")
  tipoCierre       TipoCierreContrato? @map("tipo_cierre")

  items               DetalleContrato[]
  reservas            Reserva[]
  despachos           Despacho[]
  devoluciones        Devolucion[]
  facturas            Factura[]
  solicitudesDespacho SolicitudDespacho[]
  solicitudesRetorno  SolicitudRetorno[]
  cortesFacturacion   CorteFacturacion[]
  liquidacionRetorno  LiquidacionRetorno?

  @@map("contratos")
}

model DetalleContrato {
  id               String            @id @default(uuid())
  contratoId       String            @map("contrato_id")
  contrato         Contrato          @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  equipoId         String            @map("equipo_id")
  equipo           Equipo            @relation(fields: [equipoId], references: [id])
  tipoControl      TipoControlEquipo @default(SERIALIZADO) @map("tipo_control")
  cantidad         Int               @default(1)
  dias             Decimal?          @default(1) @db.Decimal(10, 2)
  horasPorDia      Decimal?          @map("horas_por_dia") @db.Decimal(6, 2)
  horasPactadas    Decimal?          @map("horas_pactadas") @db.Decimal(10, 2)
  tipoTarifa       String?           @default("DIA") @map("tipo_tarifa")
  precioRenta      Decimal           @map("precio_renta") @db.Decimal(14, 4)
  nivelPrecio      NivelPrecio       @default(PRECIO_A) @map("nivel_precio")
  horometroInicial Float             @default(0.0) @map("horometro_inicial")

  @@map("detalle_contratos")
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

model Reserva {
  id          String        @id @default(uuid())
  contratoId  String        @map("contrato_id")
  contrato    Contrato      @relation(fields: [contratoId], references: [id])
  equipoId    String        @map("equipo_id")
  equipo      Equipo        @relation(fields: [equipoId], references: [id])
  fechaInicio DateTime      @map("fecha_inicio")
  fechaFin    DateTime      @map("fecha_fin")
  estado      EstadoReserva @default(PENDIENTE)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("reservas")
}


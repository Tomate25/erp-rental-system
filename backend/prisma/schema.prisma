  @@map("mantenimientos")
}

// --- FINANCIERO ---

enum EstadoFactura {
  PENDIENTE
  PAGADA_PARCIAL
  PAGADA
  VENCIDA
  CANCELADA
}

enum TipoFactura {
  ESTANDAR
  ANTICIPO
  RECTIFICATIVA
  CARGO_DANOS
}

enum CondicionPagoFactura {
  CONTADO
  CREDITO
}

enum EstadoCorteFacturacion {
  PENDIENTE
  FACTURADO
  ANULADO
}

model CorteFacturacion {
  id          String                 @id @default(uuid())
  contratoId  String                 @map("contrato_id")
  contrato    Contrato               @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numeroCorte Int                    @map("numero_corte")
  fechaInicio DateTime               @map("fecha_inicio")
  fechaFin    DateTime               @map("fecha_fin")
  monto       Decimal                @db.Decimal(12, 2)
  estado      EstadoCorteFacturacion @default(PENDIENTE)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  facturas Factura[]

  @@map("cortes_facturacion")
}

model Factura {
  id               String               @id @default(uuid())
  empresaId        String?              @map("empresa_id")
  empresa          Empresa?             @relation(fields: [empresaId], references: [id])
  sucursalId       String?              @map("sucursal_id")
  sucursal         Sucursal?            @relation(fields: [sucursalId], references: [id])
  clienteId        String               @map("cliente_id")
  cliente          Cliente              @relation(fields: [clienteId], references: [id])
  contratoId       String?              @map("contrato_id")
  contrato         Contrato?            @relation(fields: [contratoId], references: [id])
  cotizacionId     String?              @map("cotizacion_id")
  cotizacion       Cotizacion?          @relation(fields: [cotizacionId], references: [id])
  corteId          String?              @map("corte_id")
  corte            CorteFacturacion?    @relation(fields: [corteId], references: [id])
  devolucionId     String?              @unique @map("devolucion_id")
  devolucion       Devolucion?          @relation("FacturaCargoDevolucion", fields: [devolucionId], references: [id], onDelete: SetNull)
  detalleCargo     Json?                @map("detalle_cargo")
  detalleCorte     Json?                @map("detalle_corte")
  folio            String               @unique
  fechaEmision     DateTime             @default(now()) @map("fecha_emision")
  fechaVence       DateTime             @map("fecha_vence")
  estado           EstadoFactura        @default(PENDIENTE)
  tipoFactura      TipoFactura          @default(ESTANDAR) @map("tipo_factura")
  condicionPago    CondicionPagoFactura @default(CONTADO) @map("condicion_pago")
  plazoCreditoDias Int?                 @map("plazo_credito_dias")
  corteNumero      Int?                 @map("corte_numero")
  vendedorId       String?              @map("vendedor_id")
  vendedor         Vendedor?            @relation(fields: [vendedorId], references: [id])
  periodoComisionId String?             @map("periodo_comision_id")

  facturaPadreId  String?   @map("factura_padre_id")
  facturaPadre    Factura?  @relation("FacturaRectificativa", fields: [facturaPadreId], references: [id])
  rectificaciones Factura[] @relation("FacturaRectificativa")

  subtotal        Decimal @db.Decimal(12, 2)
  descuentoGlobal Decimal @default(0.0) @map("descuento_global") @db.Decimal(12, 2)
  retencionIva    Decimal @default(0.0) @map("retencion_iva") @db.Decimal(12, 2)
  iva             Decimal @db.Decimal(12, 2)
  total           Decimal @db.Decimal(12, 2)
  pdfUrl          String? @map("pdf_url")
  xmlUrl          String? @map("xml_url")

  pagos Pago[]

  @@map("facturas")
}

enum MetodoPago {
  TRANSFERENCIA
  TARJETA
  EFECTIVO
  CHEQUE
}

model Pago {
  id             String     @id @default(uuid())
  facturaId      String     @map("factura_id")
  factura        Factura    @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  monto          Decimal    @db.Decimal(12, 2)
  fechaPago      DateTime   @default(now()) @map("fecha_pago")
  metodo         MetodoPago
  referencia     String?
  banco          String?
  comprobanteUrl String?    @map("comprobante_url")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@map("pagos")
}

// --- NOTIFICACIONES Y AUDITORÍA ---

enum CanalNotificacion {
  EMAIL
  WHATSAPP
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIADO
  ENTREGADO
  FALLIDO
}

model Notificacion {
  id                String             @id @default(uuid())
  empresaId         String?            @map("empresa_id")
  empresa           Empresa?           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clienteId         String?            @map("cliente_id")
  cliente           Cliente?           @relation(fields: [clienteId], references: [id])
  evento            String
  canal             CanalNotificacion
  destino           String
  asunto            String?
  mensaje           String
  estado            EstadoNotificacion @default(PENDIENTE)
  tokenPublico      String?            @map("token_publico")
  claveIdempotencia String?            @unique @map("clave_idempotencia")
  intentos          Int                @default(0)
  procesando        Boolean            @default(false)
  ultimoIntento     DateTime?          @map("ultimo_intento")
  fechaEnvio        DateTime?          @map("fecha_envio")
  error             String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([empresaId])
  @@index([estado])
  @@index([estado, procesando, createdAt])
  @@map("notificaciones")
}

model Auditoria {
  id          String   @id @default(uuid())
  empresaId   String   @map("empresa_id")
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuarioId   String?  @map("usuario_id")
  usuario     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  accion      String
  entidadTipo String   @map("entidad_tipo")
  entidadId   String   @map("entidad_id")
  detalles    String
  ipDireccion String   @map("ip_direccion")
  userAgent   String   @map("user_agent")
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([empresaId, createdAt])
  @@index([empresaId, entidadTipo, entidadId])
  @@index([empresaId, usuarioId])
  @@index([requestId])
  @@map("auditorias")
}

// --- COMISIONES ---

model ReglaComision {
  id             String   @id @default(uuid())
  empresaId      String   @map("empresa_id")
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarioId      String?  @map("usuario_id")
  usuario        Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nombreVendedor String?  @map("nombre_vendedor") // E.g. "David", "Nylska"
  montoMinimo    Decimal  @map("monto_minimo") @db.Decimal(12, 2)
  montoMaximo    Decimal? @map("monto_maximo") @db.Decimal(12, 2)

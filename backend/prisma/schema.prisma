  nominaLineaId           String?                   @map("nomina_linea_id")
  asientoDevengoId        String?                   @map("asiento_devengo_id")
  asientoPagoId           String?                   @map("asiento_pago_id")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")


# ============================================================
# BM CONSTRUCCIONES - CONFIGURACIÓN DE PRODUCCIÓN (DOCKER / VPS)
# ============================================================

# --- PUERTO WEB Y RED ---
PORT_HTTP=80
PORT=3000
NODE_ENV=production
TRUSTED_PROXIES=loopback,uniquelocal

# --- BASE DE DATOS POSTGRESQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD="CAMBIAR_clave_de_postgres"
POSTGRES_DB=erp_prod
DATABASE_URL="postgresql://postgres:CAMBIAR_clave_de_postgres@postgres:5432/erp_prod?schema=public"

# --- CACHÉ REDIS ---
REDIS_URL="redis://redis:6379"

# --- SEGURIDAD JWT ---
# Generar cada secreto con: openssl rand -hex 32   (nunca reutilizar valores de otro entorno)
# docker-compose.yml exige POSTGRES_PASSWORD, DATABASE_URL, JWT_ACCESS_SECRET y JWT_REFRESH_SECRET (sin valores por defecto).
JWT_ACCESS_SECRET="CAMBIAR_secreto_jwt_acceso"
JWT_REFRESH_SECRET="CAMBIAR_secreto_jwt_refresh"
JWT_ACCESS_EXPIRATION="8h"
JWT_REFRESH_EXPIRATION="7d"

# --- SERVIDOR DE CORREO (SMTP / NOTIFICACIONES) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notificaciones@bmconstrucciones.com"
SMTP_APP_PASSWORD=""
SMTP_FROM="BM Construcciones <notificaciones@bmconstrucciones.com>"
FRONTEND_PUBLIC_URL="http://localhost"

# --- SEMILLAS (solo al ejecutar "npx prisma db seed" / scripts de usuarios; el seed FALLA si faltan) ---
ADMIN_INITIAL_EMAIL="CAMBIAR_correo_del_administrador"
ADMIN_INITIAL_PASSWORD="CAMBIAR_clave_inicial_del_administrador"

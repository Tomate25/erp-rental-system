model Empleado {
  id              String               @id @default(uuid())
  empresaId       String               @map("empresa_id")
  empresa         Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo          String
  nombres         String
  apellidos       String
  cedula          String
  ruc             String?
  numeroInss      String               @map("numero_inss")
  fechaNacimiento DateTime?            @map("fecha_nacimiento")
  sexo            String?
  direccion       String?
  telefono        String?
  email           String?
  sucursalId      String?              @map("sucursal_id")
  sucursal        Sucursal?            @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  centroCostoId   String?              @map("centro_costo_id")
  areaContable    AreaContableNomina   @default(OPERACION) @map("area_contable")
  cargo           String?
  tipoContrato    TipoContratoNomina   @default(INDETERMINADO) @map("tipo_contrato")
  fechaIngreso    DateTime             @map("fecha_ingreso")
  fechaBaja       DateTime?            @map("fecha_baja")
  causaBaja       String?              @map("causa_baja")
  tipoSalario     TipoSalarioNomina    @default(FIJO) @map("tipo_salario")
  metodoIr        MetodoIrNomina       @default(FIJO) @map("metodo_ir")
  frecuenciaPago  FrecuenciaPagoNomina @default(QUINCENAL) @map("frecuencia_pago")
  jornadaHorasDia Decimal              @default(8.00) @map("jornada_horas_dia") @db.Decimal(5, 2)
  regimenInss     RegimenInssNomina    @default(INTEGRAL) @map("regimen_inss")
  formaPago       FormaPagoNomina      @default(TRANSFERENCIA) @map("forma_pago")
  estado          EstadoEmpleado       @default(ACTIVO)
  salarioMensual  Decimal              @map("salario_mensual") @db.Decimal(14, 2)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  salarioHistorial      EmpleadoSalarioHist[]
  cuentasBancarias      EmpleadoCuentaBancaria[]
  vendedor              Vendedor?
  planillasEmpleado     PlanillaEmpleado[]
  novedades             NovedadNomina[]
  acumuladosIr          AcumuladoIr[]
  prestamos             PrestamoEmpleado[]
  movimientosVacaciones VacacionesMovimiento[]
  provisionesSaldo      ProvisionSaldo[]
  liquidacionesFinales  LiquidacionFinal[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, cedula])
  @@unique([empresaId, numeroInss])
  @@index([empresaId])
  @@map("empleados")
}


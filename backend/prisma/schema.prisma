datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// --- MULTI-TENANCY ---

model Empresa {
  id        String   @id @default(uuid())
  nombre    String
  rfc       String   @unique // Identificación fiscal
  email     String
  telefono  String?
  direccion String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sucursales          Sucursal[]
  usuarios            Usuario[]
  clientes            Cliente[]
  equipos             Equipo[]
  productos           Producto[]
  cotizaciones        Cotizacion[]
  facturas            Factura[]
  solicitudesDespacho SolicitudDespacho[]
  solicitudesRetorno  SolicitudRetorno[]

  @@map("empresas")
}

model Sucursal {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre    String
  codigo    String   @unique // Ej. SUC-NTE, SUC-SUR
  direccion String
  telefono  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuarios            Usuario[]
  equipos             Equipo[]
  contratos           Contrato[]
  despachos           Despacho[]
  devoluciones        Devolucion[]
  cotizaciones        Cotizacion[]
  facturas            Factura[]
  solicitudesDespacho SolicitudDespacho[]
  solicitudesRetorno  SolicitudRetorno[]

  @@map("sucursales")
}

// --- USUARIOS Y RBAC ---

model Usuario {
  id                     String    @id @default(uuid())
  empresaId              String    @map("empresa_id")
  empresa                Empresa   @relation(fields: [empresaId], references: [id])
  sucursalId             String?   @map("sucursal_id")
  sucursal               Sucursal? @relation(fields: [sucursalId], references: [id])
  email                  String    @unique
  password               String // Hash Argon2
  nombre                 String
  apellido               String
  activo                 Boolean   @default(true)
  intentosFallidos       Int       @default(0) @map("intentos_fallidos")
  bloqueado              Boolean   @default(false)
  requiereCambioPassword Boolean   @default(false) @map("requiere_cambio_password")
  sessionToken           String?   @map("session_token")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  roles        UsuarioRol[]
  auditorias   Auditoria[]
  cotizaciones Cotizacion[]

  @@map("usuarios")
}

model Rol {
  id          String  @id @default(uuid())
  nombre      String  @unique // Ej. ADMIN, GERENTE, COMERCIAL, CLIENTE
  descripcion String?

  permisos RolPermiso[]
  usuarios UsuarioRol[]

  @@map("roles")
}

model Permiso {
  id          String  @id @default(uuid())
  codigo      String  @unique // Ej. CLIENT.CREATE, QUOTE.APPROVE
  descripcion String?

  roles RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     String  @map("rol_id")
  permisoId String  @map("permiso_id")
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permisos")
}

model UsuarioRol {
  usuarioId String  @map("usuario_id")
  rolId     String  @map("rol_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuario_roles")
}

// --- CLIENTES ---

model Cliente {
  id                 String   @id @default(uuid())
  empresaId          String   @map("empresa_id")
  empresa            Empresa  @relation(fields: [empresaId], references: [id])
  numeroCliente      String?  @map("numero_cliente")
  nombre             String // Nombre comercial o completo
  razonSocial        String?  @map("razon_social")
  rfc                String? // Identificación fiscal del cliente (Ruc)
  cedula             String?
  direccion          String?
  emailFacturacion   String?  @map("email_facturacion")
  telefono           String?
  telMovistar        String?  @map("tel_movistar")
  telClaro           String?  @map("tel_claro")
  telConvencional    String?  @map("tel_convencional")
  vendedor           String?
  limiteCredito      Float?   @map("limite_credito")
  condicionPago      String?  @map("condicion_pago")
  whatsappHabilitado Boolean  @default(false) @map("whatsapp_habilitado")
  whatsappNumero     String?  @map("whatsapp_numero")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  contactos      ContactoCliente[]
  solicitudes    Solicitud[]
  cotizaciones   Cotizacion[]
  contratos      Contrato[]
  facturas       Factura[]
  notificaciones Notificacion[]

  @@map("clientes")
}

model ContactoCliente {
  id        String   @id @default(uuid())
  clienteId String   @map("cliente_id")
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nombre    String
  puesto    String?
  email     String   @unique
  telefono  String
  password  String? // Hash Argon2 si tiene acceso al portal de clientes
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contactos_cliente")
}

// --- INVENTARIO Y DISPONIBILIDAD ---

enum TipoControlEquipo {
  SERIALIZADO
  POR_CANTIDAD
}

enum EstadoEquipo {
  DISPONIBLE
  RESERVADO
  RENTADO
  RETORNO
  DESPACHADO
  EN_ALQUILER
  EN_RETORNO
  EN_INSPECCION
  EN_MANTENIMIENTO
  MANTENIMIENTO
  FUERA_DE_SERVICIO
  BAJA
}

model Categoria {
  id              String         @id @default(uuid())
  nombre          String         @unique
  descripcion     String?
  isLineaAmarilla Boolean        @default(false) @map("is_linea_amarilla")
  subcategorias   Subcategoria[]
  equipos         Equipo[]
  productos       Producto[]

  @@map("categorias")
}

model Subcategoria {
  id          String    @id @default(uuid())
  categoriaId String    @map("categoria_id")
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  equipos     Equipo[]
  productos   Producto[]

  @@unique([categoriaId, nombre])
  @@map("subcategorias")
}

model Marca {
  id        String     @id @default(uuid())
  nombre    String     @unique
  equipos   Equipo[]
  productos Producto[]

  @@map("marcas")
}

model Producto {
  id              String            @id @default(uuid())
  empresaId       String            @map("empresa_id")
  empresa         Empresa           @relation(fields: [empresaId], references: [id])
  categoriaId     String            @map("categoria_id")
  categoria       Categoria         @relation(fields: [categoriaId], references: [id])
  subcategoriaId  String?           @map("subcategoria_id")
  subcategoria    Subcategoria?     @relation(fields: [subcategoriaId], references: [id])
  marcaId         String            @map("marca_id")
  marca           Marca             @relation(fields: [marcaId], references: [id])
  codigo          String?           @map("codigo")
  nombre          String
  descripcion     String?
  tipoControl     TipoControlEquipo @default(SERIALIZADO) @map("tipo_control")
  precioRentaDia  Float             @map("precio_renta_dia")
  precioRentaHora Float?            @map("precio_renta_hora")
  minimoHoras     Int?              @default(4) @map("minimo_horas")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  equipos            Equipo[]
  detallesCotizacion DetalleCotizacion[]

  @@map("productos")
}

model Equipo {
  id                 String             @id @default(uuid())
  empresaId          String             @map("empresa_id")
  empresa            Empresa            @relation(fields: [empresaId], references: [id])
  sucursalId         String             @map("sucursal_id")
  sucursal           Sucursal           @relation(fields: [sucursalId], references: [id])
  productoId         String?            @map("producto_id")
  producto           Producto?          @relation(fields: [productoId], references: [id])
  categoriaId        String             @map("categoria_id")
  categoria          Categoria          @relation(fields: [categoriaId], references: [id])
  subcategoriaId     String?            @map("subcategoria_id")
  subcategoria       Subcategoria?      @relation(fields: [subcategoriaId], references: [id])
  marcaId            String             @map("marca_id")
  marca              Marca              @relation(fields: [marcaId], references: [id])
  codigo             String?            @map("codigo") // Código de artículo: 01-02, 02-64, etc.
  modelo             String
  numeroSerie        String?            @unique @map("numero_serie") // Opcional para activos en masa
  tipoControl        TipoControlEquipo  @default(SERIALIZADO) @map("tipo_control")
  descripcion        String?
  estado             EstadoEquipo       @default(DISPONIBLE)
  cantidadTotal      Int                @default(1) @map("cantidad_total") // Stock total del artículo
  cantidadDisponible Int                @default(1) @map("cantidad_disponible") // Stock disponible (decrece al rentar)
  horometro               Float              @default(0.0) // Horas de uso acumuladas
  horometroUltimoServicio Float              @default(0.0) @map("horometro_ultimo_servicio") // Horas al último mantenimiento
  intervaloServicioHoras  Float              @default(250.0) @map("intervalo_servicio_horas") // Intervalo (ej. 250 hrs)
  precioRentaDia          Float              @map("precio_renta_dia")
  precioRentaHora         Float?             @map("precio_renta_hora")
  minimoHoras             Int?               @default(4) @map("minimo_horas")
  costoAdquisicion        Float?             @map("costo_adquisicion")
  fechaAdquisicion        DateTime?          @map("fecha_adquisicion")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  reservas           Reserva[]
  detallesContrato   DetalleContrato[]
  despachos          DetalleDespacho[]
  devoluciones       DetalleDevolucion[]
  mantenimientos     Mantenimiento[]
  detallesCotizacion DetalleCotizacion[]
  lecturasHorometro  LecturaHorometro[]

  @@map("equipos")
}

enum OrigenLecturaHorometro {
  DESPACHO
  RETORNO
  INSPECCION_CAMPO
  MANTENIMIENTO
  AJUSTE_MANUAL
}

model LecturaHorometro {
  id                String                 @id @default(uuid())
  equipoId          String                 @map("equipo_id")
  equipo            Equipo                 @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  horometroAnterior Float                  @map("horometro_anterior")
  horometroNuevo    Float                  @map("horometro_nuevo")
  horasTrabajadas   Float                  @map("horas_trabajadas")
  origen            OrigenLecturaHorometro @default(INSPECCION_CAMPO)
  registradoPor     String?                @map("registrado_por")
  observaciones     String?
  createdAt         DateTime               @default(now()) @map("created_at")

  @@map("lecturas_horometro")
}

// --- PROCESO COMERCIAL ---

enum EstadoSolicitud {
  PENDIENTE
  COTIZADA
  RECHAZADA
  CANCELADA
}

model Solicitud {
  id           String          @id @default(uuid())
  clienteId    String          @map("cliente_id")
  cliente      Cliente         @relation(fields: [clienteId], references: [id])
  fechaUso     DateTime        @map("fecha_uso")
  duracionDias Int             @map("duracion_dias")
  comentarios  String?
  estado       EstadoSolicitud @default(PENDIENTE)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@map("solicitudes")
}

enum EstadoCotizacion {
  BORRADOR
  PENDIENTE
  ENVIADA
  VISTA
  EN_REVISION
  ACEPTADA
  CONVERTIDA_A_CONTRATO
  FACTURADA
  RECHAZADA
  VENCIDA
  CANCELADA
}

model Cotizacion {
  id               String           @id @default(uuid())
  empresaId        String?          @map("empresa_id")
  empresa          Empresa?         @relation(fields: [empresaId], references: [id])
  sucursalId       String?          @map("sucursal_id")
  sucursal         Sucursal?        @relation(fields: [sucursalId], references: [id])
  numeroCotizacion String           @map("numero_cotizacion") // Ej. COT-0001
  version          Int              @default(1)
  clienteId        String           @map("cliente_id")
  cliente          Cliente          @relation(fields: [clienteId], references: [id])
  proyecto         String?
  atencion         String?
  telefono         String?
  email            String?
  referencia       String?
  asesorId         String?          @map("asesor_id")
  asesor           Usuario?         @relation(fields: [asesorId], references: [id])
  estado           EstadoCotizacion @default(BORRADOR)
  fechaEmision     DateTime         @default(now()) @map("fecha_emision")
  fechaVence       DateTime         @map("fecha_vence")
  validezDias      Int              @default(15) @map("validez_dias")
  subtotal         Float
  descuento        Float            @default(0)
  iva              Float
  total            Float
  depositoGarantia Float            @default(0.0) @map("deposito_garantia")
  condiciones      String?
  notasRevision    String?          @map("notas_revision")
  tokenPublico     String           @unique @default(uuid()) @map("token_publico")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  items     DetalleCotizacion[]
  contratos Contrato[]
  facturas  Factura[]

  @@map("cotizaciones")
}

enum TipoCobro {
  POR_DIA
  POR_HORA
}

model DetalleCotizacion {
  id             String     @id @default(uuid())
  cotizacionId   String     @map("cotizacion_id")
  cotizacion     Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  productoId     String?    @map("producto_id")
  producto       Producto?  @relation(fields: [productoId], references: [id])
  equipoId       String?    @map("equipo_id")
  equipo         Equipo?    @relation(fields: [equipoId], references: [id])
  descripcion    String
  tipoCobro      TipoCobro  @default(POR_DIA) @map("tipo_cobro")
  cantidad       Int        @default(1)
  dias           Int?       @default(1)
  horas          Int?
  precioUnitario Float      @map("precio_unitario")
  descuento      Float      @default(0)
  subtotal       Float

  @@map("detalle_cotizacion")
}

enum EstadoContrato {
  ACTIVO
  FINALIZADO
  CANCELADO
  EN_DISPUTA
}

model Contrato {
  id               String         @id @default(uuid())
  sucursalId       String         @map("sucursal_id")
  sucursal         Sucursal       @relation(fields: [sucursalId], references: [id])
  clienteId        String         @map("cliente_id")
  cliente          Cliente        @relation(fields: [clienteId], references: [id])
  cotizacionId     String?        @map("cotizacion_id")
  cotizacion       Cotizacion?    @relation(fields: [cotizacionId], references: [id])
  codigo           String         @unique
  fechaInicio      DateTime       @map("fecha_inicio")
  fechaFin         DateTime       @map("fecha_fin")
  estado           EstadoContrato @default(ACTIVO)
  depositoGarantia Float          @default(0.0) @map("deposito_garantia")
  condiciones      String
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  items               DetalleContrato[]
  reservas            Reserva[]
  despachos           Despacho[]
  devoluciones        Devolucion[]
  facturas            Factura[]
  solicitudesDespacho SolicitudDespacho[]
  solicitudesRetorno  SolicitudRetorno[]
  cortesFacturacion   CorteFacturacion[]

  @@map("contratos")
}

model DetalleContrato {
  id               String            @id @default(uuid())
  contratoId       String            @map("contrato_id")
  contrato         Contrato          @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  equipoId         String            @map("equipo_id")
  equipo           Equipo            @relation(fields: [equipoId], references: [id])
  tipoControl      TipoControlEquipo @default(SERIALIZADO) @map("tipo_control")
  cantidad         Int               @default(1)
  dias             Int?              @default(1)
  tipoTarifa       String?           @default("DIA") @map("tipo_tarifa")
  precioRenta      Float             @map("precio_renta")
  horometroInicial Float             @default(0.0) @map("horometro_inicial")

  @@map("detalle_contratos")
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

model Reserva {
  id          String        @id @default(uuid())
  contratoId  String        @map("contrato_id")
  contrato    Contrato      @relation(fields: [contratoId], references: [id])
  equipoId    String        @map("equipo_id")
  equipo      Equipo        @relation(fields: [equipoId], references: [id])
  fechaInicio DateTime      @map("fecha_inicio")
  fechaFin    DateTime      @map("fecha_fin")
  estado      EstadoReserva @default(PENDIENTE)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("reservas")
}

// --- OPERACIONES Y MANTENIMIENTO ---

enum EstadoSolicitudOperativa {
  PENDIENTE
  APROBADA
  EN_PROCESO
  COMPLETADA
  RECHAZADA
  CANCELADA
}

model SolicitudDespacho {
  id               String                   @id @default(uuid())
  codigo           String                   @unique
  empresaId        String                   @map("empresa_id")
  empresa          Empresa                  @relation(fields: [empresaId], references: [id])
  sucursalId       String                   @map("sucursal_id")
  sucursal         Sucursal                 @relation(fields: [sucursalId], references: [id])
  contratoId       String                   @map("contrato_id")
  contrato         Contrato                 @relation(fields: [contratoId], references: [id])
  solicitadoPor    String?                  @map("solicitado_por")
  fechaProgramada  DateTime                 @map("fecha_programada")
  direccionEntrega String?                  @map("direccion_entrega")
  estado           EstadoSolicitudOperativa @default(PENDIENTE)
  comentarios      String?
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  despachos Despacho[]

  @@map("solicitudes_despacho")
}

model SolicitudRetorno {
  id               String                   @id @default(uuid())
  codigo           String                   @unique
  empresaId        String                   @map("empresa_id")
  empresa          Empresa                  @relation(fields: [empresaId], references: [id])
  sucursalId       String                   @map("sucursal_id")
  sucursal         Sucursal                 @relation(fields: [sucursalId], references: [id])
  contratoId       String                   @map("contrato_id")
  contrato         Contrato                 @relation(fields: [contratoId], references: [id])
  solicitadoPor    String?                  @map("solicitado_por")
  fechaProgramada  DateTime                 @map("fecha_programada")
  lugarRecoleccion String?                  @map("lugar_recoleccion")
  estado           EstadoSolicitudOperativa @default(PENDIENTE)
  comentarios      String?
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  devoluciones Devolucion[]

  @@map("solicitudes_retorno")
}

model Despacho {
  id                  String             @id @default(uuid())
  sucursalId          String             @map("sucursal_id")
  sucursal            Sucursal           @relation(fields: [sucursalId], references: [id])
  contratoId          String             @map("contrato_id")
  contrato            Contrato           @relation(fields: [contratoId], references: [id])
  solicitudDespachoId String?            @map("solicitud_despacho_id")
  solicitudDespacho   SolicitudDespacho? @relation(fields: [solicitudDespachoId], references: [id])
  operadorNombre      String?            @map("operador_nombre")
  vehiculoEnvio       String?            @map("vehiculo_envio")
  fechaDespacho       DateTime           @default(now()) @map("fecha_despacho")
  comentarios         String?
  createdAt           DateTime           @default(now()) @map("created_at")

  items DetalleDespacho[]

  @@map("despachos")
}

model DetalleDespacho {
  id               String   @id @default(uuid())
  despachoId       String   @map("despacho_id")
  despacho         Despacho @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  equipoId         String   @map("equipo_id")
  equipo           Equipo   @relation(fields: [equipoId], references: [id])
  numeroSerie      String?  @map("numero_serie")
  cantidad         Int      @default(1)
  horometroInicial Float    @default(0.0) @map("horometro_inicial")
  estadoSalida     String   @default("BUENO") @map("estado_salida")
  checklistOk      Boolean  @default(true) @map("checklist_ok")
  observaciones    String?
  fotosUrls        String[] @map("fotos_urls")

  inspeccionesSalida InspeccionSalida[]

  @@map("detalle_despacho")
}

model InspeccionSalida {
  id                String          @id @default(uuid())
  detalleDespachoId String          @map("detalle_despacho_id")
  detalleDespacho   DetalleDespacho @relation(fields: [detalleDespachoId], references: [id], onDelete: Cascade)
  combustible       String?         @default("100%")
  aceiteOk          Boolean         @default(true) @map("aceite_ok")
  llantasOk         Boolean         @default(true) @map("llantas_ok")
  hidraulicoOk      Boolean         @default(true) @map("hidraulico_ok")
  motorOk           Boolean         @default(true) @map("motor_ok")
  fugasDetectadas   Boolean         @default(false) @map("fugas_detectadas")
  observaciones     String?
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("inspecciones_salida")
}

model Devolucion {
  id                 String            @id @default(uuid())
  sucursalId         String            @map("sucursal_id")
  sucursal           Sucursal          @relation(fields: [sucursalId], references: [id])
  contratoId         String            @map("contrato_id")
  contrato           Contrato          @relation(fields: [contratoId], references: [id])
  solicitudRetornoId String?           @map("solicitud_retorno_id")
  solicitudRetorno   SolicitudRetorno? @relation(fields: [solicitudRetornoId], references: [id])
  fechaDevolucion    DateTime          @default(now()) @map("fecha_devolucion")
  recibidoPor        String            @map("recibido_por")
  createdAt          DateTime          @default(now()) @map("created_at")

  items DetalleDevolucion[]

  @@map("devoluciones")
}

model DetalleDevolucion {
  id                String     @id @default(uuid())
  devolucionId      String     @map("devolucion_id")
  devolucion        Devolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  equipoId          String     @map("equipo_id")
  equipo            Equipo     @relation(fields: [equipoId], references: [id])
  numeroSerie       String?    @map("numero_serie")
  cantidadRetornada Int        @default(1) @map("cantidad_retornada")
  cantidadDañada    Int        @default(0) @map("cantidad_danada")
  cantidadPerdida   Int        @default(0) @map("cantidad_perdida")
  horometroFinal    Float      @default(0.0) @map("horometro_final")
  horasCalculadas   Float      @default(0.0) @map("horas_calculadas")
  daniosDetectados  Boolean    @default(false) @map("danios_detectados")
  descripcionDanios String?    @map("descripcion_danios")
  fotosUrls         String[]   @map("fotos_urls")

  inspeccionesDanio InspeccionDano[]

  @@map("detalle_devolucion")
}

enum SeveridadDano {
  BAJA
  MEDIA
  ALTA
  PERDIDA_TOTAL
}

model InspeccionDano {
  id                  String            @id @default(uuid())
  detalleDevolucionId String            @map("detalle_devolucion_id")
  detalleDevolucion   DetalleDevolucion @relation(fields: [detalleDevolucionId], references: [id], onDelete: Cascade)
  componente          String
  tipoDano            String            @map("tipo_dano")
  severidad           SeveridadDano     @default(MEDIA)
  cobrable            Boolean           @default(true)
  costoEstimado       Float             @default(0.0) @map("costo_estimado")
  evidenciaUrl        String?           @map("evidencia_url")
  observaciones       String?
  createdAt           DateTime          @default(now()) @map("created_at")

  @@map("inspecciones_dano")
}

enum TipoMantenimiento {
  PREVENTIVO
  CORRECTIVO
}

enum EstadoMantenimiento {
  PROGRAMADO
  EN_PROCESO
  COMPLETADO
  CANCELADO
}

model Mantenimiento {
  id                String              @id @default(uuid())
  equipoId          String              @map("equipo_id")
  equipo            Equipo              @relation(fields: [equipoId], references: [id])
  tipo              TipoMantenimiento
  estado            EstadoMantenimiento @default(PROGRAMADO)
  fechaProgramacion DateTime            @map("fecha_programacion")
  fechaEjecucion    DateTime?           @map("fecha_ejecucion")
  horometroServicio Float               @map("horometro_servicio")
  descripcion       String
  costo             Float               @default(0.0)
  insumosUtilizados String?             @map("insumos_utilizados")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@map("mantenimientos")
}

// --- FINANCIERO ---

enum EstadoFactura {
  PENDIENTE
  PAGADA
  VENCIDA
  CANCELADA
}

enum TipoFactura {
  ESTANDAR
  ANTICIPO
  RECTIFICATIVA
  CARGO_DANOS
}

enum CondicionPagoFactura {
  CONTADO
  CREDITO
}

enum EstadoCorteFacturacion {
  PENDIENTE
  FACTURADO
  ANULADO
}

model CorteFacturacion {
  id          String                 @id @default(uuid())
  contratoId  String                 @map("contrato_id")
  contrato    Contrato               @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numeroCorte Int                    @map("numero_corte")
  fechaInicio DateTime               @map("fecha_inicio")
  fechaFin    DateTime               @map("fecha_fin")
  monto       Float
  estado      EstadoCorteFacturacion @default(PENDIENTE)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  facturas Factura[]

  @@map("cortes_facturacion")
}

model Factura {
  id               String               @id @default(uuid())
  empresaId        String?              @map("empresa_id")
  empresa          Empresa?             @relation(fields: [empresaId], references: [id])
  sucursalId       String?              @map("sucursal_id")
  sucursal         Sucursal?            @relation(fields: [sucursalId], references: [id])
  clienteId        String               @map("cliente_id")
  cliente          Cliente              @relation(fields: [clienteId], references: [id])
  contratoId       String?              @map("contrato_id")
  contrato         Contrato?            @relation(fields: [contratoId], references: [id])
  cotizacionId     String?              @map("cotizacion_id")
  cotizacion       Cotizacion?          @relation(fields: [cotizacionId], references: [id])
  corteId          String?              @map("corte_id")
  corte            CorteFacturacion?    @relation(fields: [corteId], references: [id])
  folio            String               @unique
  fechaEmision     DateTime             @default(now()) @map("fecha_emision")
  fechaVence       DateTime             @map("fecha_vence")
  estado           EstadoFactura        @default(PENDIENTE)
  tipoFactura      TipoFactura          @default(ESTANDAR) @map("tipo_factura")
  condicionPago    CondicionPagoFactura @default(CONTADO) @map("condicion_pago")
  plazoCreditoDias Int?                 @map("plazo_credito_dias")
  corteNumero      Int?                 @map("corte_numero")

  facturaPadreId  String?   @map("factura_padre_id")
  facturaPadre    Factura?  @relation("FacturaRectificativa", fields: [facturaPadreId], references: [id])
  rectificaciones Factura[] @relation("FacturaRectificativa")

  subtotal        Float
  descuentoGlobal Float   @default(0.0) @map("descuento_global")
  retencionIva    Float   @default(0.0) @map("retencion_iva")
  iva             Float
  total           Float
  pdfUrl          String? @map("pdf_url")
  xmlUrl          String? @map("xml_url")

  pagos Pago[]

  @@map("facturas")
}

enum MetodoPago {
  TRANSFERENCIA
  TARJETA
  EFECTIVO
  CHEQUE
}

model Pago {
  id             String     @id @default(uuid())
  facturaId      String     @map("factura_id")
  factura        Factura    @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  monto          Float
  fechaPago      DateTime   @default(now()) @map("fecha_pago")
  metodo         MetodoPago
  referencia     String?
  comprobanteUrl String?    @map("comprobante_url")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@map("pagos")
}

// --- NOTIFICACIONES Y AUDITORÍA ---

enum CanalNotificacion {
  EMAIL
  WHATSAPP
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIADO
  ENTREGADO
  FALLIDO
}

model Notificacion {
  id           String             @id @default(uuid())
  clienteId    String?            @map("cliente_id")
  cliente      Cliente?           @relation(fields: [clienteId], references: [id])
  evento       String
  canal        CanalNotificacion
  destino      String
  asunto       String?
  mensaje      String
  estado       EstadoNotificacion @default(PENDIENTE)
  tokenPublico String?            @map("token_publico")
  fechaEnvio   DateTime?          @map("fecha_envio")
  error        String?
  createdAt    DateTime           @default(now()) @map("created_at")

  @@map("notificaciones")
}

model Auditoria {
  id          String   @id @default(uuid())
  usuarioId   String?  @map("usuario_id")
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])
  accion      String
  entidadTipo String   @map("entidad_tipo")
  entidadId   String   @map("entidad_id")
  detalles    String
  ipDireccion String   @map("ip_direccion")
  userAgent   String   @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("auditorias")
}

model PlanillaEmpleado {
  id               String             @id @default(uuid())
  planillaId       String             @map("planilla_id")
  planilla         Planilla           @relation(fields: [planillaId], references: [id], onDelete: Cascade)
  empleadoId       String             @map("empleado_id")
  empleado         Empleado           @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  salarioMensual   Decimal            @map("salario_mensual") @db.Decimal(14, 2)
  sucursalId       String?            @map("sucursal_id")
  centroCostoId    String?            @map("centro_costo_id")
  areaContable     AreaContableNomina @map("area_contable")
  metodoIr         MetodoIrNomina     @map("metodo_ir")
  diasTrabajados   Decimal            @default(15.00) @map("dias_trabajados") @db.Decimal(5, 2)
  snapshotTasas    Json?              @map("snapshot_tasas")
  totalDevengado   Decimal            @map("total_devengado") @db.Decimal(14, 2)
  totalDeducciones Decimal            @map("total_deducciones") @db.Decimal(14, 2)
  netoPagar        Decimal            @map("neto_pagar") @db.Decimal(14, 2)
  costoPatronal    Decimal            @map("costo_patronal") @db.Decimal(14, 2)
  createdAt        DateTime           @default(now()) @map("created_at")

  lineas PlanillaLinea[]

  @@unique([planillaId, empleadoId])
  @@index([planillaId])
  @@index([empleadoId])
  @@map("planillas_empleado")
}

model PlanillaLinea {
  id                 String           @id @default(uuid())
  planillaEmpleadoId String           @map("planilla_empleado_id")
  planillaEmpleado   PlanillaEmpleado @relation(fields: [planillaEmpleadoId], references: [id], onDelete: Cascade)
  conceptoId         String           @map("concepto_id")
  concepto           ConceptoNomina   @relation(fields: [conceptoId], references: [id], onDelete: Cascade)
  cantidad           Decimal?         @db.Decimal(10, 2)
  base               Decimal?         @db.Decimal(14, 2)
  tasa               Decimal?         @db.Decimal(7, 4)
  monto              Decimal          @db.Decimal(14, 2)
  referenciaTipo     String?          @map("referencia_tipo")
  referenciaId       String?          @map("referencia_id")
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([planillaEmpleadoId])
  @@index([conceptoId])
  @@map("planillas_lineas")
}

model NovedadNomina {
  id               String              @id @default(uuid())
  empresaId        String              @map("empresa_id")
  empresa          Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empleadoId       String              @map("empleado_id")
  empleado         Empleado            @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  periodoDestinoId String              @map("periodo_destino_id")
  periodoDestino   PeriodoNomina       @relation(fields: [periodoDestinoId], references: [id], onDelete: Cascade)
  conceptoId       String              @map("concepto_id")
  concepto         ConceptoNomina      @relation(fields: [conceptoId], references: [id], onDelete: Cascade)
  cantidad         Decimal?            @db.Decimal(10, 2)
  monto            Decimal             @db.Decimal(14, 2)
  origen           OrigenNovedadNomina @default(MANUAL)
  referenciaId     String?             @map("referencia_id")
  periodoDevengo   String?             @map("periodo_devengo")
  estado           EstadoNovedadNomina @default(PENDIENTE)
  aprobadoPor      String?             @map("aprobado_por")
  observaciones    String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([empleadoId])
  @@index([periodoDestinoId])
  @@index([origen, referenciaId])
  @@map("novedades_nomina")
}

model AcumuladoIr {
  id                  String   @id @default(uuid())
  empleadoId          String   @map("empleado_id")
  empleado            Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  anio                Int
  mes                 Int
  rentaBruta          Decimal  @map("renta_bruta") @db.Decimal(14, 2)
  inssLaboral         Decimal  @map("inss_laboral") @db.Decimal(14, 2)
  rentaNeta           Decimal  @map("renta_neta") @db.Decimal(14, 2)
  rentaNetaAcumulada  Decimal  @map("renta_neta_acumulada") @db.Decimal(14, 2)
  mesesTranscurridos  Int      @map("meses_transcurridos")
  irAnualProyectado   Decimal  @map("ir_anual_proyectado") @db.Decimal(14, 2)
  irRetenidoMes       Decimal  @map("ir_retenido_mes") @db.Decimal(14, 2)
  irRetenidoAcumulado Decimal  @map("ir_retenido_acumulado") @db.Decimal(14, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([empleadoId, anio, mes])
  @@index([empleadoId])
  @@map("acumulados_ir")
}

model PrestamoEmpleado {
  id          String                 @id @default(uuid())
  empresaId   String                 @map("empresa_id")
  empresa     Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empleadoId  String                 @map("empleado_id")
  empleado    Empleado               @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  tipo        TipoPrestamoEmpleado   @default(PRESTAMO)
  monto       Decimal                @db.Decimal(14, 2)
  fecha       DateTime
  cuotas      Int
  cuotaMonto  Decimal                @map("cuota_monto") @db.Decimal(14, 2)
  saldo       Decimal                @db.Decimal(14, 2)
  estado      EstadoPrestamoEmpleado @default(ACTIVO)
  descripcion String?
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  cuotasDetalle PrestamoCuota[]

  @@index([empleadoId])
  @@map("prestamos_empleados")
}

model PrestamoCuota {
  id         String           @id @default(uuid())
  prestamoId String           @map("prestamo_id")
  prestamo   PrestamoEmpleado @relation(fields: [prestamoId], references: [id], onDelete: Cascade)
  numero     Int
  monto      Decimal          @db.Decimal(14, 2)
  aplicado   Boolean          @default(false)
  fechaPago  DateTime?        @map("fecha_pago")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([prestamoId])
  @@map("prestamos_cuotas")
}

model VacacionesMovimiento {
  id         String                   @id @default(uuid())
  empleadoId String                   @map("empleado_id")
  empleado   Empleado                 @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  fecha      DateTime
  tipo       TipoMovimientoVacaciones
  dias       Decimal                  @db.Decimal(6, 2)
  referencia String?
  createdAt  DateTime                 @default(now()) @map("created_at")

  @@index([empleadoId])
  @@map("vacaciones_movimientos")
}

model ProvisionSaldo {
  id                 String              @id @default(uuid())
  empleadoId         String              @map("empleado_id")
  empleado           Empleado            @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  tipo               TipoProvisionNomina
  anio               Int
  mes                Int
  baseUsada          Decimal             @map("base_usada") @db.Decimal(14, 2)
  requeridoAcumulado Decimal             @map("requerido_acumulado") @db.Decimal(14, 2)
  provisionMes       Decimal             @map("provision_mes") @db.Decimal(14, 2)
  consumido          Decimal             @default(0) @db.Decimal(14, 2)
  saldo              Decimal             @db.Decimal(14, 2)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@unique([empleadoId, tipo, anio, mes])
  @@index([empleadoId])
  @@map("provisiones_saldo")
}

model LiquidacionFinal {
  id                       String                 @id @default(uuid())
  empleadoId               String                 @map("empleado_id")
  empleado                 Empleado               @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  fechaBaja                DateTime               @map("fecha_baja")
  causa                    String
  antiguedadAnios          Decimal                @map("antiguedad_anios") @db.Decimal(6, 4)
  salarioBaseIndemnizacion Decimal                @map("salario_base_indemnizacion") @db.Decimal(14, 2)
  diasVacacionesPendientes Decimal                @map("dias_vacaciones_pendientes") @db.Decimal(6, 2)
  mesesAguinaldo           Decimal                @map("meses_aguinaldo") @db.Decimal(6, 2)
  montoSalarioPendiente    Decimal                @default(0) @map("monto_salario_pendiente") @db.Decimal(14, 2)
  montoVacaciones          Decimal                @default(0) @map("monto_vacaciones") @db.Decimal(14, 2)
  montoAguinaldo           Decimal                @default(0) @map("monto_aguinaldo") @db.Decimal(14, 2)
  montoIndemnizacion       Decimal                @default(0) @map("monto_indemnizacion") @db.Decimal(14, 2)
  montoTotalDevengado      Decimal                @map("monto_total_devengado") @db.Decimal(14, 2)
  deduccionInss            Decimal                @default(0) @map("deduccion_inss") @db.Decimal(14, 2)
  deduccionIr              Decimal                @default(0) @map("deduccion_ir") @db.Decimal(14, 2)
  deduccionPrestamos       Decimal                @default(0) @map("deduccion_prestamos") @db.Decimal(14, 2)
  montoNetoPagar           Decimal                @map("monto_neto_pagar") @db.Decimal(14, 2)
  planillaId               String?                @map("planilla_id")
  planilla                 Planilla?              @relation(fields: [planillaId], references: [id], onDelete: SetNull)
  estado                   EstadoLiquidacionFinal @default(BORRADOR)
  aprobadoPor              String?                @map("aprobado_por")
  aprobadoEn               DateTime?              @map("aprobado_en")
  pagadoEn                 DateTime?              @map("pagado_en")
  observaciones            String?
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")

  @@index([empleadoId])
  @@map("liquidaciones_finales")
}

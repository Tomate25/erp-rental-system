  totalNc                 Decimal                   @map("total_nc") @db.Decimal(14, 2)
  arrastreAplicado        Decimal                   @default(0) @map("arrastre_aplicado") @db.Decimal(14, 2)
  baseComisionable        Decimal                   @map("base_comisionable") @db.Decimal(14, 2)
  comisionCalculada       Decimal                   @map("comision_calculada") @db.Decimal(14, 2)
  totalAjustes            Decimal                   @default(0) @map("total_ajustes") @db.Decimal(14, 2)
  comisionTotal           Decimal                   @map("comision_total") @db.Decimal(14, 2)
  arrastreGenerado        Decimal                   @default(0) @map("arrastre_generado") @db.Decimal(14, 2)
  desgloseSucursal        Json?                     @map("desglose_sucursal")
  calculadoEn             DateTime                  @default(now()) @map("calculado_en")
  nRecalculos             Int                       @default(0) @map("n_recalculos")
  revisadoPor             String?                   @map("revisado_por")
  revisadoEn              DateTime?                 @map("revisado_en")
  aprobadoPor             String?                   @map("aprobado_por")
  aprobadoEn              DateTime?                 @map("aprobado_en")
  pagadoEn                DateTime?                 @map("pagado_en")
  anuladoPor              String?                   @map("anulado_por")
  anuladoEn               DateTime?                 @map("anulado_en")

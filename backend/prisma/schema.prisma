  fechaInicioCobro    DateTime                 @map("fecha_inicio_cobro")
  fechaRecepcion      DateTime                 @map("fecha_recepcion")
  fechaFinPactada     DateTime                 @map("fecha_fin_pactada")
  diasPactados        Int                      @map("dias_pactados")
  diasCobrados        Int                      @map("dias_cobrados")
  diasAnticipados     Int                      @map("dias_anticipados")
  montoPactado        Decimal                  @map("monto_pactado") @db.Decimal(12, 2)
  montoDevengado      Decimal                  @map("monto_devengado") @db.Decimal(12, 2)
  montoFacturado      Decimal                  @default(0) @map("monto_facturado") @db.Decimal(12, 2)
  creditoCliente      Decimal                  @default(0) @map("credito_cliente") @db.Decimal(12, 2)
  destinoCredito      DestinoCreditoRetorno?   @map("destino_credito")
  requiereNotaCredito Boolean                  @default(false) @map("requiere_nota_credito")
  aprobadoPor         String?                  @map("aprobado_por")
  aprobadoAt          DateTime?                @map("aprobado_at")
  detalle             Json?
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@map("liquidaciones_retorno")
}

model DetalleDevolucion {
  id                    String     @id @default(uuid())
  devolucionId          String     @map("devolucion_id")
  devolucion            Devolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  equipoId              String     @map("equipo_id")
  equipo                Equipo     @relation(fields: [equipoId], references: [id])
  numeroSerie           String?    @map("numero_serie")
  cantidadRetornada     Int        @default(1) @map("cantidad_retornada")
  cantidadDañada       Int        @default(0) @map("cantidad_danada")
  cantidadPerdida       Int        @default(0) @map("cantidad_perdida")
  horometroFinal        Float      @default(0.0) @map("horometro_final")
  horasCalculadas       Float      @default(0.0) @map("horas_calculadas")
  combustibleRetorno    String?    @map("combustible_retorno")
  nivelCombustible      Float?     @map("nivel_combustible")
  diferenciaCombustible Float?     @map("diferencia_combustible")
  cargoCombustible      Decimal?   @default(0.0) @map("cargo_combustible") @db.Decimal(12, 2)
  daniosDetectados      Boolean    @default(false) @map("danios_detectados")
  descripcionDanios     String?    @map("descripcion_danios")
  fotosUrls             String[]   @map("fotos_urls")
  inspeccionEstado      Json?      @map("inspeccion_estado")

  inspeccionesDanio InspeccionDano[]
  reparaciones      Mantenimiento[]

  @@map("detalle_devolucion")
}

enum SeveridadDano {
  BAJA
  MEDIA
  ALTA
  PERDIDA_TOTAL
}

model InspeccionDano {
  id                  String            @id @default(uuid())
  detalleDevolucionId String            @map("detalle_devolucion_id")
  detalleDevolucion   DetalleDevolucion @relation(fields: [detalleDevolucionId], references: [id], onDelete: Cascade)
  componente          String
  tipoDano            String            @map("tipo_dano")
  severidad           SeveridadDano     @default(MEDIA)
  cobrable            Boolean           @default(true)
  costoEstimado       Decimal           @default(0.0) @map("costo_estimado") @db.Decimal(12, 2)
  evidenciaUrl        String?           @map("evidencia_url")
  observaciones       String?
  createdAt           DateTime          @default(now()) @map("created_at")

  @@map("inspecciones_dano")
}

enum TipoMantenimiento {
  PREVENTIVO
  CORRECTIVO
}

enum EstadoMantenimiento {
  PROGRAMADO
  EN_PROCESO
  COMPLETADO
  CANCELADO
}

model Mantenimiento {
  id                  String              @id @default(uuid())
  equipoId            String              @map("equipo_id")
  equipo              Equipo              @relation(fields: [equipoId], references: [id])
  detalleDevolucionId String?             @map("detalle_devolucion_id")
  detalleDevolucion   DetalleDevolucion?  @relation(fields: [detalleDevolucionId], references: [id], onDelete: SetNull)
  cobrableCliente     Boolean             @default(false) @map("cobrable_cliente")

# --- CONFIGURACIÓN GENERAL DEL SISTEMA ---
PORT=3000
NODE_ENV=development # development, test, production

# --- CONFIGURACIÓN DE BASE DE DATOS (POSTGRESQL) ---
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://db_user:db_password@localhost:5432/erp_dev?schema=public"

# --- CONFIGURACIÓN DE CACHÉ (REDIS) ---
REDIS_URL="redis://localhost:6379"

# --- SEGURIDAD Y JWT ---
# Cambiar por frases secretas largas y seguras en producción
JWT_ACCESS_SECRET="super-secret-access-token-key-2026"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-2026"
JWT_ACCESS_EXPIRATION="15m" # Expiración corta (15 minutos)
JWT_REFRESH_EXPIRATION="7d" # Expiración larga (7 días)

# --- PROVEEDOR DE CORREO (SMTP) ---
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="ERP Rental System <noreply@yourdomain.com>"

# --- PROVEEDOR DE WHATSAPP BUSINESS ---
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# --- ALMACENAMIENTO DE ARCHIVOS (AWS S3 / MINIO / LOCAL) ---
STORAGE_PROVIDER="local" # local, s3, minio
STORAGE_BUCKET_NAME="erp-rental-assets"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ENDPOINT=""

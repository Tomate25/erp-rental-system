  tramos     LiquidacionComisionTramo[]
  ajustes    AjusteComision[]

  @@unique([periodoId, vendedorId])
  @@index([empresaId])
  @@index([periodoId])
  @@index([vendedorId])
  @@map("liquidaciones_comision")
}


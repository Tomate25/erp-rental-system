enum MetodoCalculoComision {
  TRAMO_UNICO
  ESCALONADO
}

enum BaseCalculoComision {
  FACTURADO
  COBRADO
}

enum TratamientoNegativoComision {
  ARRASTRAR
  RECUPERAR
}

enum EstadoVersionPlan {
  BORRADOR
  ACTIVA
  CERRADA
}

enum EstadoPeriodoComision {
  ABIERTO
  EN_LIQUIDACION
  CERRADO
}

enum EstadoLiquidacionComision {
  BORRADOR
  REVISADO
  APROBADO
  PAGADO
  ANULADO
}

enum TipoDocComision {
  FACTURA
  NOTA_CREDITO
  RECIBO
  ANULACION_POSTERIOR
}

enum MotivoAjusteComision {
  ERROR_VENDEDOR
  VENTA_ESPECIAL
  CORRECCION_PERIODO_ANTERIOR
  OTRO
}

enum EstadoAjusteComision {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model Vendedor {
  id             String    @id @default(uuid())
  empresaId      String    @map("empresa_id")
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo         String
  empleadoId     String?   @unique @map("empleado_id")
  empleado       Empleado? @relation(fields: [empleadoId], references: [id], onDelete: SetNull)
  nombreMostrar  String    @map("nombre_mostrar")
  sucursalId     String?   @map("sucursal_id")
  sucursal       Sucursal? @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  usuarioId      String?   @map("usuario_id")
  usuario        Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  esComisionable Boolean   @default(true) @map("es_comisionable")
  fechaAlta      DateTime? @map("fecha_alta")
  fechaBaja      DateTime? @map("fecha_baja")
  activo         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  asignaciones   AsignacionVendedorPlan[]
  liquidaciones  LiquidacionComision[]
  saldosArrastre SaldoArrastreComision[]
  cotizaciones   Cotizacion[]
  facturas       Factura[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@map("vendedores")
}

model PlanComision {
  id          String   @id @default(uuid())
  empresaId   String   @map("empresa_id")
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo      String
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  versiones    PlanComisionVersion[]
  asignaciones AsignacionVendedorPlan[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@map("planes_comision")
}

model PlanComisionVersion {
  id                  String                      @id @default(uuid())
  planId              String                      @map("plan_id")
  plan                PlanComision                @relation(fields: [planId], references: [id], onDelete: Cascade)
  version             Int                         @default(1)
  vigenteDesde        DateTime                    @map("vigente_desde")
  vigenteHasta        DateTime?                   @map("vigente_hasta")
  metodo              MetodoCalculoComision       @default(ESCALONADO)
  base                BaseCalculoComision         @default(FACTURADO)
  incluyeIva          Boolean                     @default(false) @map("incluye_iva")
  tratamientoNegativo TratamientoNegativoComision @default(ARRASTRAR) @map("tratamiento_negativo")
  mesesMaxArrastre    Int                         @default(3) @map("meses_max_arrastre")
  estado              EstadoVersionPlan           @default(ACTIVA)
  aprobadoPor         String?                     @map("aprobado_por")
  aprobadoEn          DateTime?                   @map("aprobado_en")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  tramos        TramoComision[]
  liquidaciones LiquidacionComision[]

  @@index([planId])
  @@map("planes_comision_versiones")
}

model TramoComision {

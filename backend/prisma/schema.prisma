  nivelCombustible  Float?          @map("nivel_combustible")
  aceiteOk          Boolean         @default(true) @map("aceite_ok")
  llantasOk         Boolean         @default(true) @map("llantas_ok")
  hidraulicoOk      Boolean         @default(true) @map("hidraulico_ok")
  motorOk           Boolean         @default(true) @map("motor_ok")
  fugasDetectadas   Boolean         @default(false) @map("fugas_detectadas")
  observaciones     String?
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("inspecciones_salida")
}

model Devolucion {
  id                  String            @id @default(uuid())
  sucursalId          String            @map("sucursal_id")
  sucursal            Sucursal          @relation(fields: [sucursalId], references: [id])
  contratoId          String            @map("contrato_id")
  contrato            Contrato          @relation(fields: [contratoId], references: [id])
  solicitudRetornoId  String?           @map("solicitud_retorno_id")
  solicitudRetorno    SolicitudRetorno? @relation(fields: [solicitudRetornoId], references: [id])
  fechaDevolucion     DateTime          @default(now()) @map("fecha_devolucion")
  recibidoPor         String            @map("recibido_por")
  entregadoPor        String?           @map("entregado_por")
  cedulaEntregante    String?           @map("cedula_entregante")
  actaRetornoData     Json?             @map("acta_retorno_data")
  esRetornoAnticipado Boolean           @default(false) @map("es_retorno_anticipado")
  diasAnticipados     Int               @default(0) @map("dias_anticipados")
  createdAt           DateTime          @default(now()) @map("created_at")

  items             DetalleDevolucion[]
  facturaCargo      Factura?            @relation("FacturaCargoDevolucion")
  liquidacionCierre LiquidacionRetorno?

  @@map("devoluciones")
}

model LiquidacionRetorno {
  id                  String                   @id @default(uuid())
  contratoId          String                   @unique @map("contrato_id")
  contrato            Contrato                 @relation(fields: [contratoId], references: [id], onDelete: Restrict)
  devolucionCierreId  String                   @unique @map("devolucion_cierre_id")
  devolucionCierre    Devolucion               @relation(fields: [devolucionCierreId], references: [id], onDelete: Restrict)
